<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="controller.GradeDialogController" spacing="10" prefWidth="350">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
    
    <Label text="Ученик:"/>
    <ComboBox fx:id="studentCombo" prefWidth="300"/>

    <Label text="Предмет:"/>
    <TextField fx:id="subjectField" promptText="Например: Математика"/>
    
    <Label text="Оценка (1-5):"/>
    <Spinner fx:id="valueSpinner" editable="true" prefWidth="100">
        <valueFactory>
            <SpinnerValueFactory.IntegerSpinnerValueFactory min="1" max="5" initialValue="5"/>
        </valueFactory>
    </Spinner>

    <Label text="Дата:"/>
    <DatePicker fx:id="datePicker" prefWidth="200"/>

    <Label text="Статус:"/>
    <ComboBox fx:id="statusCombo" prefWidth="200"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <padding><Insets top="20"/></padding>
        <Button fx:id="saveBtn" text="Сохранить" onAction="#handleSave"/>
        <Button fx:id="cancelBtn" text="Отмена" onAction="#handleCancel"/>
    </HBox>
</VBox>